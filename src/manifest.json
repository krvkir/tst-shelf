{
	"manifest_version": 2,
	"name": "TST Shelf",
	"version": "0.2.3",
	"description": "Shelves for Tree Style Tab: put constant tabs of a project on a favicon strap inside their parent's row, fold their subtrees until selected.",
	"browser_specific_settings": {
		"gecko": {
			"id": "tst-shelf@example.com",
			"strict_min_version": "115.0",
			"data_collection_permissions": { "required": ["none"] }
		}
	},
	"permissions": [
		"tabs",
		"tabHide",
		"storage",
		"sessions",
		"menus"
	],
	"background": {
		"persistent": true,
		"scripts": ["background.js"]
	},
	"options_ui": { "page": "options.html", "open_in_tab": false },
	"icons": { "48": "icons/48.png", "96": "icons/96.png" }
}
